{
  "name": "Minecraft Server",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "forwardPorts": [8443],
  "portsAttributes": { "8443": { "protocol": "https" } },
  "postStartCommand": "bash start.sh"
}
